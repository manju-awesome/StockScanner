# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Used specifically by market_movers.send_resend_email — the sender shared
# by movers emails, CRITICAL/HIGH Alert digests, and the Pre-Market Brief
# (core/alerts.py, core/premarket_brief.py). ALERT_EMAIL_FROM must be a
# domain verified with Resend, or sends will fail even with a valid key.
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=alerts@yourdomain.com

# Optional: pushes the same CRITICAL/HIGH digest to Telegram alongside email
# (core/alerts.py's send_alert_telegram via market_movers.send_telegram_message).
# Create a bot with @BotFather to get TELEGRAM_BOT_TOKEN, send it one message,
# then GET https://api.telegram.org/bot<token>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Position sizing (dashboard R:R·SIZE line)
# shares = ACCOUNT_SIZE × RISK_PER_TRADE_PCT% × size-flag ÷ (entry − stop),
# capped at MAX_POSITION_PCT% of the account per position.
ACCOUNT_SIZE=100000
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=25

# Optional: enables Claude-generated features (dashboard morning-summary
# polish, and the Journal page's AI coach trade review). Both features
# degrade gracefully — dashboard keeps its template summary, and the
# Journal's "AI Review" button reports a clear error — when this is unset.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─────────────────────────────────────────────────────────────
# Day Trade (spydaytrader): SPY 0DTE signal engine + order pipeline.
# ACCOUNT_SIZE / RISK_PER_TRADE_PCT / MAX_POSITION_PCT above are shared
# with it — for a 0DTE option the whole premium paid is the risk, so
# RISK_PER_TRADE_PCT caps premium the same way it caps share risk.
# ─────────────────────────────────────────────────────────────
# Robinhood account to use for order placement. Must be set explicitly here
# or given to Claude directly in-session — the MCP tools refuse to infer it
# from get_accounts(), and this project never places an order without an
# explicit per-order confirmation regardless of what's configured here.
ROBINHOOD_ACCOUNT_NUMBER=

# Position sizing — % of account treated as max premium at risk per trade.
# For a 0DTE option, the whole premium paid is the risk (it can expire
# worthless), so this plays the same role RISK_PER_TRADE_PCT plays for a
# share stop-loss in StockAnalysis_Version1.

# Premium-based exit band (percent move on the option premium itself), the
# other half of the "both" exit rule alongside the underlying signal flip.
OPTIONS_STOP_PCT=-35
OPTIONS_TARGET_PCT=60

# Stop new trades for the rest of the day once realized losses hit this
# percent of ACCOUNT_SIZE (checked against data/journal_trades.json).
DAILY_LOSS_LIMIT_PCT=2

# UT Bot (SVMKR_UT_HMA_ORB Pine Script) parameters — match the TradingView
# indicator's own inputs so signals line up with what you see on the chart.
UT_KEY_VALUE=2
UT_ATR_PERIOD=1
HMA_PERIOD=31
MA200_PERIOD=200

# Opening range window — changed from the script's default 10:10-10:15 ET
# to the standard market open per your request.
ORB_SESSION_START=09:30
ORB_MINUTES=15

# Bar interval for signal computation (yfinance interval string).
BAR_INTERVAL=5m
